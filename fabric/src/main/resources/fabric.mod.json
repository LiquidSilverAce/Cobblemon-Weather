{
  "schemaVersion": 1,
  "id": "cobblemon_weather",
  "version": "${version}",
  "name": "Cobblemon Weather",
  "description": "Overworld weather driven by Cobblemon battle moves and abilities, with a configurable player whitelist.",
  "authors": [
    "LiquidSilverAce"
  ],
  "contact": {
    "sources": "https://github.com/LiquidSilverAce/Cobblemon-Weather"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.weather.fabric.ExampleModFabric"
    ],
    "client": [
      "com.weather.fabric.client.ExampleModFabricClient"
    ]
  },
  "mixins": [
    "cobblemon_weather.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*"
  },
  "suggests": {
    "cobblemon": ">=1.7.3 <1.9",
    "particlerain": "*"
  },
  "breaks": {
    "cobblemon": [
      "<1.7.3",
      ">=1.9"
    ]
  }
}
